index=linux_os sourcetype=system_metrics earliest=-30m latest=now
| stats count count(cpu_usage) AS cpu_parsed count(ram_usage) AS ram_parsed latest(_time) AS latest_event latest(cpu_usage) AS latest_cpu latest(ram_usage) AS latest_ram by host splunk_server
| eval latest_event=strftime(latest_event,"%Y-%m-%d %H:%M:%S %z")
